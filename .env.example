# Vercel Preview: set only APP_MODE=demo. No database or Supabase keys required.
APP_MODE=demo
# Authenticated mode: set APP_MODE=production on a separate TEST project first.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated Supabase Auth UUIDs; empty means nobody is authorized.
AUTH_ALLOWED_USER_IDS=
