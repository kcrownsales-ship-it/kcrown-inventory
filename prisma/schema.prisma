generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../generated/prisma"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}
// Atomic aggregate with PostgreSQL transaction locking. Demo never connects here.
model InventoryState {
 id String @id
 data Json
 updatedAt DateTime @updatedAt
}
